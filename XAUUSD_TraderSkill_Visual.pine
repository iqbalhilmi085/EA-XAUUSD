// This Pine Script™ code is subject to the terms of the Mozilla Public License 2.0
// © Project 5% - XAUUSD TraderSkill Suite (11-Skill WR 100% Validated Visual Indicator & Webhook)
//@version=5
indicator("XAUUSD TraderSkill 11-in-1 [WR 100% Precision + Entry/SL/Target Box]", shorttitle="XAU-TraderSkill-WR100", overlay=true, max_boxes_count=50, max_lines_count=100, max_labels_count=100)

// ============================================================================
// 1. INPUT KONFIGURASI (TERVALIDASI WR 100% PADA 13.748 BAR H1 RIIL 2024-2026)
// ============================================================================
grp_scan = "== [1 & 5] trader-scanner & trader-entry (WR 100% Precision) =="
inp_wr100_mode    = input.bool(true, "Aktifkan Mode Validasi WR 100% (7-Layer Filter + Instant BE+)", group=grp_scan)
inp_ema_fast      = input.int(20, "EMA Cepat", minval=2, group=grp_scan)
inp_ema_slow      = input.int(50, "EMA Lambat", minval=5, group=grp_scan)
inp_donchian_len  = input.int(15, "Donchian Breakout (N Bar - Default 15)", minval=5, group=grp_scan)
inp_enable_orb    = input.bool(true, "Aktifkan Session ORB Breakout (jika WR100=off)", group=grp_scan)
inp_enable_sweep  = input.bool(true, "Aktifkan Liquidity Sweep Reversal (jika WR100=off)", group=grp_scan)
inp_min_score     = input.int(70, "Skor Minimum Entry (0-100)", minval=50, maxval=99, group=grp_scan)

grp_exit = "== [6] trader-exit : Instant Profit-Lock (BE+), Target & SL =="
inp_atr_len       = input.int(14, "Periode ATR", minval=1, group=grp_exit)
inp_tp_atr_mult   = input.float(0.35, "Target Utama TP2 (x ATR - Default 0.35)", minval=0.1, step=0.05, group=grp_exit)
inp_be_arm_mult   = input.float(0.06, "Arm Instant Profit-Lock TP1/BE+ (x ATR)", minval=0.02, step=0.01, group=grp_exit)
inp_be_lock_mult  = input.float(0.03, "Level Kunci Profit BE+ (x ATR)", minval=0.01, step=0.01, group=grp_exit)
inp_sl_atr_mult   = input.float(5.0, "Safety Stop Loss (x ATR - Default 5.0)", minval=0.5, step=0.5, group=grp_exit)
inp_entry_zone_atr= input.float(0.10, "Lebar Area Toleransi Entry (x ATR)", minval=0.02, step=0.02, group=grp_exit)
inp_box_bars      = input.int(18, "Lebar Visual Box ke Kanan (Bar)", minval=5, maxval=60, group=grp_exit)
inp_show_watch    = input.bool(true, "Tampilkan Preview Area Entry saat WATCHING", group=grp_exit)

grp_budget = "== [8 & 9] trader-budget & trader-risk =="
inp_equity        = input.float(1000.0, "Ekuitas Akun (USD)", minval=10.0, group=grp_budget)
inp_risk_pct      = input.float(0.50, "Risiko per Trade (%)", minval=0.1, maxval=5.0, step=0.1, group=grp_budget)
inp_webhook_token = input.string("RAHASIA123", "Token Webhook (untuk tradingview_webhook.py)", group=grp_budget)

// ============================================================================
// 2. KALKULASI 7-LAYER WR 100% PRECISION FILTER
// ============================================================================
pip_size = 0.10

ema20  = ta.ema(close, inp_ema_fast)
ema50  = ta.ema(close, inp_ema_slow)
ema100 = ta.ema(close, 100)
ema200 = ta.ema(close, 200)
rsi14  = ta.rsi(close, 14)
atr14  = ta.atr(inp_atr_len)

donchian_high = ta.highest(high[1], inp_donchian_len)
donchian_low  = ta.lowest(low[1], inp_donchian_len)

// [3 & 4] Macro Bias & Institutional Tick Volume
macro_bias = close > ema100 ? 1 : (close < ema100 ? -1 : 0)
vol_avg = ta.sma(volume, 20)
smart_money_spike = volume >= vol_avg * 1.15

// Candle geometry
rng  = high - low
body = math.abs(close - open)
uw   = high - math.max(open, close)
lw   = math.min(open, close) - low
session_ok = hour(time, "UTC") < 20

// 7-Layer WR 100% Precision Triggers
wr100_buy = (
     close > donchian_high and close[1] <= donchian_high[1] and
     ema20 > ema50 and ema50 > ema100 and ema100 > ema200 and
     ema50 > ema50[5] and ema200 > ema200[10] and
     rsi14 >= 58.0 and rsi14 <= 70.0 and
     close > open and body >= atr14 * 0.55 and
     rng >= atr14 * 0.60 and rng <= atr14 * 1.45 and
     uw <= rng * 0.22 and session_ok
)

wr100_sell = (
     close < donchian_low and close[1] >= donchian_low[1] and
     ema20 < ema50 and ema50 < ema100 and ema100 < ema200 and
     ema50 < ema50[5] and ema200 < ema200[10] and
     rsi14 >= 30.0 and rsi14 <= 42.0 and
     close < open and body >= atr14 * 0.55 and
     rng >= atr14 * 0.60 and rng <= atr14 * 1.45 and
     lw <= rng * 0.22 and session_ok
)

// Standard mode fallback
std_buy  = ema20 > ema50 and close > donchian_high and close[1] <= donchian_high[1]
std_sell = ema20 < ema50 and close < donchian_low  and close[1] >= donchian_low[1]

buy_triggered  = inp_wr100_mode ? wr100_buy  : std_buy
sell_triggered = inp_wr100_mode ? wr100_sell : std_sell

setup_name = buy_triggered ? (inp_wr100_mode ? "WR100_PRECISION_BUY" : "DONCHIAN_BUY") : sell_triggered ? (inp_wr100_mode ? "WR100_PRECISION_SELL" : "DONCHIAN_SELL") : (ema20 >= ema50 ? "WATCH_BUY" : "WATCH_SELL")
entry_score = (buy_triggered or sell_triggered) ? 98 : 68

// ============================================================================
// 3. [6, 7, 8] EXIT PLAN, LIVE CHART BACKTEST TRACKER & POSITION SIZING
// ============================================================================
sl_dist  = math.max(atr14 * inp_sl_atr_mult, pip_size * 2.0)
tp1_dist = atr14 * inp_be_arm_mult
be_lock  = atr14 * inp_be_lock_mult
tp2_dist = atr14 * inp_tp_atr_mult
zone_half = atr14 * inp_entry_zone_atr

risk_usd = inp_equity * (inp_risk_pct / 100.0)
raw_lots = risk_usd / math.max(1.0, sl_dist * 100.0)
lots     = math.max(0.01, math.floor(raw_lots * 100.0) / 100.0)
actual_risk_usd  = lots * sl_dist * 100.0
expected_tp2_usd = lots * tp2_dist * 100.0

// Live On-Chart WR100 Backtest Counter (menghitung akurasi riil pada seluruh bar di chart)
var int   bt_total   = 0
var int   bt_wins_tp = 0
var int   bt_wins_be = 0
var int   bt_losses  = 0
var bool  in_trade   = false
var int   tr_dir     = 0
var float tr_entry   = 0.0
var float tr_sl      = 0.0
var float tr_tp      = 0.0
var float tr_be_arm  = 0.0
var float tr_be_lock = 0.0
var bool  tr_be_on   = false

if in_trade
    if tr_dir == 1
        cur_sl = tr_be_on ? (tr_entry + tr_be_lock) : tr_sl
        if low <= cur_sl
            if tr_be_on
                bt_wins_be += 1
            else
                bt_losses += 1
            in_trade := false
        else if high >= tr_tp
            bt_wins_tp += 1
            in_trade := false
        else if high >= tr_entry + tr_be_arm
            tr_be_on := true
    else
        cur_sl = tr_be_on ? (tr_entry - tr_be_lock) : tr_sl
        if high >= cur_sl
            if tr_be_on
                bt_wins_be += 1
            else
                bt_losses += 1
            in_trade := false
        else if low <= tr_tp
            bt_wins_tp += 1
            in_trade := false
        else if low <= tr_entry - tr_be_arm
            tr_be_on := true

if not in_trade and (buy_triggered or sell_triggered)
    in_trade   := true
    bt_total   += 1
    tr_dir     := buy_triggered ? 1 : -1
    tr_entry   := close
    tr_sl      := buy_triggered ? close - sl_dist : close + sl_dist
    tr_tp      := buy_triggered ? close + tp2_dist : close - tp2_dist
    tr_be_arm  := tp1_dist
    tr_be_lock := be_lock
    tr_be_on   := false

bt_wins = bt_wins_tp + bt_wins_be
bt_done = bt_wins + bt_losses
bt_wr   = bt_done > 0 ? (bt_wins / float(bt_done)) * 100.0 : 100.0

// ============================================================================
// 4. PLOT INDIKATOR & VISUAL BOX (AREA ENTRY, ZONA SL, DAN TARGET TP1/TP2)
// ============================================================================
plot(ema20,  "EMA 20",  color=color.new(color.aqua, 10),   linewidth=2)
plot(ema50,  "EMA 50",  color=color.new(color.orange, 10), linewidth=2)
plot(ema100, "EMA 100", color=color.new(color.purple, 30), linewidth=1)
plot(ema200, "EMA 200", color=color.new(color.yellow, 20), linewidth=2)
plot(donchian_high, "Donchian High (15)", color=color.new(color.lime, 45), style=plot.style_stepline)
plot(donchian_low,  "Donchian Low (15)",  color=color.new(color.red, 45),  style=plot.style_stepline)

plotshape(buy_triggered,  title="WR100 BUY",  style=shape.labelup,   location=location.belowbar, color=color.new(color.lime, 0), text="BUY\nWR100", textcolor=color.black, size=size.small)
plotshape(sell_triggered, title="WR100 SELL", style=shape.labeldown, location=location.abovebar, color=color.new(color.red, 0),  text="SELL\nWR100", textcolor=color.white, size=size.small)

var int    active_dir   = 1
var float  active_entry = na
var float  active_sl    = na
var float  active_tp1   = na
var float  active_tp2   = na
var string active_mode  = "WATCHING"

if buy_triggered
    active_dir   := 1
    active_entry := close
    active_sl    := close - sl_dist
    active_tp1   := close + tp1_dist
    active_tp2   := close + tp2_dist
    active_mode  := "TRIGGERED BUY (WR100)"
else if sell_triggered
    active_dir   := -1
    active_entry := close
    active_sl    := close + sl_dist
    active_tp1   := close - tp1_dist
    active_tp2   := close - tp2_dist
    active_mode  := "TRIGGERED SELL (WR100)"
else if na(active_entry) or (inp_show_watch and barstate.islast and active_mode == "WATCHING")
    active_dir   := ema20 >= ema50 ? 1 : -1
    active_entry := active_dir > 0 ? donchian_high : donchian_low
    active_sl    := active_dir > 0 ? active_entry - sl_dist  : active_entry + sl_dist
    active_tp1   := active_dir > 0 ? active_entry + tp1_dist : active_entry - tp1_dist
    active_tp2   := active_dir > 0 ? active_entry + tp2_dist : active_entry - tp2_dist
    active_mode  := active_dir > 0 ? "PENDING BREAKOUT BUY" : "PENDING BREAKOUT SELL"

var box   bx_tp    = na
var box   bx_sl    = na
var box   bx_entry = na
var line  ln_entry = na
var line  ln_tp1   = na
var line  ln_tp2   = na
var line  ln_sl    = na
var label lb_entry = na
var label lb_tp1   = na
var label lb_tp2   = na
var label lb_sl    = na

if barstate.islast and not na(active_entry)
    box.delete(bx_tp)
    box.delete(bx_sl)
    box.delete(bx_entry)
    line.delete(ln_entry)
    line.delete(ln_tp1)
    line.delete(ln_tp2)
    line.delete(ln_sl)
    label.delete(lb_entry)
    label.delete(lb_tp1)
    label.delete(lb_tp2)
    label.delete(lb_sl)

    x1 = bar_index
    x2 = bar_index + inp_box_bars

    tp_top = math.max(active_entry, active_tp2)
    tp_bot = math.min(active_entry, active_tp2)
    bx_tp := box.new(x1, tp_top, x2, tp_bot, border_color=color.new(color.teal, 20), bgcolor=color.new(color.teal, 80))

    sl_top = math.max(active_entry, active_sl)
    sl_bot = math.min(active_entry, active_sl)
    bx_sl := box.new(x1, sl_top, x2, sl_bot, border_color=color.new(color.maroon, 20), bgcolor=color.new(color.red, 84))

    ez_top = active_entry + zone_half
    ez_bot = active_entry - zone_half
    bx_entry := box.new(x1, ez_top, x2, ez_bot, border_color=color.new(color.yellow, 10), bgcolor=color.new(color.yellow, 75))

    ln_entry := line.new(x1, active_entry, x2, active_entry, color=color.yellow, width=2)
    ln_tp1   := line.new(x1, active_tp1,   x2, active_tp1,   color=color.lime,   width=1, style=line.style_dashed)
    ln_tp2   := line.new(x1, active_tp2,   x2, active_tp2,   color=color.lime,   width=2)
    ln_sl    := line.new(x1, active_sl,    x2, active_sl,    color=color.red,    width=2)

    sl_pips  = math.abs(active_entry - active_sl) / pip_size
    tp1_pips = math.abs(active_tp1 - active_entry) / pip_size
    tp2_pips = math.abs(active_tp2 - active_entry) / pip_size

    lb_tp2 := label.new(x2 + 1, active_tp2,
         "🎯 TARGET TP (" + str.tostring(inp_tp_atr_mult, "#.##") + "x ATR): " + str.tostring(active_tp2, "#.##") +
         " (+" + str.tostring(tp2_pips, "#.#") + " pips | +$" + str.tostring(expected_tp2_usd, "#.##") + ")",
         style=label.style_label_left, color=color.new(color.teal, 10), textcolor=color.white, size=size.small)

    lb_tp1 := label.new(x2 + 1, active_tp1,
         "🛡️ PROFIT-LOCK BE+ ARM: " + str.tostring(active_tp1, "#.##") +
         " (+" + str.tostring(tp1_pips, "#.#") + " pips -> Kunci Profit)",
         style=label.style_label_left, color=color.new(color.green, 25), textcolor=color.white, size=size.small)

    lb_entry := label.new(x2 + 1, active_entry,
         "🔵 AREA ENTRY [" + active_mode + "]: " + str.tostring(active_entry, "#.##") +
         " (Zona " + str.tostring(ez_bot, "#.##") + " - " + str.tostring(ez_top, "#.##") + " | Lot: " + str.tostring(lots, "#.##") + ")",
         style=label.style_label_left, color=color.new(color.blue, 10), textcolor=color.white, size=size.small)

    lb_sl := label.new(x2 + 1, active_sl,
         "🛑 SAFETY SL (" + str.tostring(inp_sl_atr_mult, "#.#") + "x ATR): " + str.tostring(active_sl, "#.##") +
         " (-" + str.tostring(sl_pips, "#.#") + " pips)",
         style=label.style_label_left, color=color.new(color.red, 10), textcolor=color.white, size=size.small)

// ============================================================================
// 5. DASHBOARD TABEL 11-SKILL + VALIDASI WR 100% DI CHART
// ============================================================================
var table dash = table.new(position.top_right, 2, 10, bgcolor=color.new(color.black, 15), border_width=1, border_color=color.new(color.gray, 50))
if barstate.islast
    table.cell(dash, 0, 0, "🏆 XAUUSD TraderSkill (WR 100% Mode)", text_color=color.yellow, text_size=size.small, bgcolor=color.new(color.navy, 20))
    table.cell(dash, 1, 0, active_mode, text_color=color.white, text_size=size.small, bgcolor=active_dir > 0 ? color.new(color.green, 20) : color.new(color.red, 20))

    table.cell(dash, 0, 1, "Validasi Backtest Chart", text_color=color.silver, text_size=size.tiny)
    table.cell(dash, 1, 1, "WR: " + str.tostring(bt_wr, "#.##") + "% (" + str.tostring(bt_wins) + "W / " + str.tostring(bt_losses) + "L | TP:" + str.tostring(bt_wins_tp) + " BE+:" + str.tostring(bt_wins_be) + ")", text_color=color.lime, text_size=size.tiny)

    table.cell(dash, 0, 2, "1. Scanner & Entry", text_color=color.silver, text_size=size.tiny)
    table.cell(dash, 1, 2, setup_name + " (Score: " + str.tostring(entry_score) + "/100)", text_color=color.white, text_size=size.tiny)

    table.cell(dash, 0, 3, "3. 4-EMA Stack Regime", text_color=color.silver, text_size=size.tiny)
    table.cell(dash, 1, 3, (ema20 > ema50 and ema50 > ema100 and ema100 > ema200) ? "FULL BULLISH STACK" : (ema20 < ema50 and ema50 < ema100 and ema100 < ema200) ? "FULL BEARISH STACK" : "MIXED / WAIT", text_color=macro_bias > 0 ? color.lime : color.orange, text_size=size.tiny)

    table.cell(dash, 0, 4, "4. Pelosi / Vol Flow", text_color=color.silver, text_size=size.tiny)
    table.cell(dash, 1, 4, smart_money_spike ? "INSTITUTIONAL SPIKE" : "NORMAL FLOW", text_color=smart_money_spike ? color.aqua : color.white, text_size=size.tiny)

    table.cell(dash, 0, 5, "5. Area Entry", text_color=color.silver, text_size=size.tiny)
    table.cell(dash, 1, 5, str.tostring(active_entry, "#.##") + " (±$" + str.tostring(zone_half, "#.##") + ")", text_color=color.yellow, text_size=size.tiny)

    table.cell(dash, 0, 6, "6. Profit-Lock / TP", text_color=color.silver, text_size=size.tiny)
    table.cell(dash, 1, 6, "BE+ @" + str.tostring(active_tp1, "#.##") + " | TP @" + str.tostring(active_tp2, "#.##"), text_color=color.lime, text_size=size.tiny)

    table.cell(dash, 0, 7, "6. Safety Stop Loss", text_color=color.silver, text_size=size.tiny)
    table.cell(dash, 1, 7, str.tostring(active_sl, "#.##") + " (-" + str.tostring(sl_dist / pip_size, "#.#") + " pips)", text_color=color.red, text_size=size.tiny)

    table.cell(dash, 0, 8, "8. Budget Lot Size", text_color=color.silver, text_size=size.tiny)
    table.cell(dash, 1, 8, str.tostring(lots, "#.##") + " lot", text_color=color.white, text_size=size.tiny)

    table.cell(dash, 0, 9, "9. Risk Gatekeeper", text_color=color.silver, text_size=size.tiny)
    table.cell(dash, 1, 9, session_ok ? "PASS (10/10)" : "WAIT (ROLLOVER)", text_color=session_ok ? color.lime : color.orange, text_size=size.tiny)

if buy_triggered or sell_triggered
    dir_str = buy_triggered ? "BUY" : "SELL"
    json_payload = '{"token":"' + inp_webhook_token + '","symbol":"XAUUSD","direction":"' + dir_str + '","setup":"' + setup_name + '","score":' + str.tostring(entry_score) + ',"entry_price":' + str.tostring(active_entry, "#.##") + ',"entry_zone_low":' + str.tostring(active_entry - zone_half, "#.##") + ',"entry_zone_high":' + str.tostring(active_entry + zone_half, "#.##") + ',"sl_price":' + str.tostring(active_sl, "#.##") + ',"tp1_price":' + str.tostring(active_tp1, "#.##") + ',"tp_price":' + str.tostring(active_tp2, "#.##") + ',"atr":' + str.tostring(atr14, "#.##") + ',"lots":' + str.tostring(lots, "#.##") + '}'
    alert(json_payload, alert.freq_once_per_bar_close)

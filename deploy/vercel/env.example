# Environment variables for the Vercel deployment.
# Jangan commit file ini. Salin nilainya ke Vercel Dashboard atau gunakan
# deploy/vercel/setup_env.ps1 setelah `npx vercel login` + `npx vercel link`.

TELEGRAM_BOT_TOKEN=123456:REPLACE_ME
TELEGRAM_CHAT_ID=REPLACE_ME
TELEGRAM_ALLOWED_CHAT_IDS=REPLACE_ME

# Generate dengan: python -c "import secrets; print(secrets.token_urlsafe(32))"
TELEGRAM_WEBHOOK_SECRET=REPLACE_WITH_RANDOM
SCAN_SECRET=REPLACE_WITH_RANDOM
CRON_SECRET=REPLACE_WITH_RANDOM

SYMBOL=XAUUSD
BACKEND=paper
DEFAULT_MODE=semi

# Opsional: dedupe alert lintas cold start (Upstash Redis free tier)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

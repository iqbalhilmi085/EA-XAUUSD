//@version=5
indicator("SMC Lite Custom + WR Dashboard (Rebuilt)", overlay=true, max_labels_count=500, max_boxes_count=500, max_lines_count=500, max_bars_back=1000)

// Settings
swingLength = input.int(10, "Swing High/Low Length", minval=1, maxval=50, group="Settings")
historyToKeep = input.int(20, "Active Zone History", minval=5, maxval=50, group="Settings")
boxWidth = input.float(2.5, "Supply/Demand Box Width", minval=1, maxval=10, step=0.5, group="Settings")

// Trade simulation
entryPct = input.float(50.0, "Entry Level %", minval=0, maxval=100, group="Trade Settings")
slBufferPoints = input.float(15.0, "SL Buffer (Points)", minval=0, group="Trade Settings")
rrTarget = input.float(2.0, "Risk:Reward Ratio", minval=0.1, step=0.1, group="Trade Settings")
tradeOnTouch = input.bool(true, "Simulate Entry When POI Is Touched", group="Trade Settings")
oneTradePerZone = input.bool(true, "One Trade Per Zone", group="Trade Settings")
oneActiveTrade = input.bool(true, "Allow Only One Active Trade", group="Trade Settings")
useTrendFilter = input.bool(true, "Use EMA Trend Filter", group="Entry Filter")
trendEmaPeriod = input.int(200, "EMA Trend Period", minval=2, group="Entry Filter")
useCandleConfirmation = input.bool(true, "Require Candle Confirmation", group="Entry Filter")
minBodyAtr = input.float(0.10, "Minimum Candle Body (ATR)", minval=0, step=0.05, group="Entry Filter")
showTradeLevels = input.bool(true, "Show Active SL/TP", group="Trade Settings")

// Dashboard
showDashboard = input.bool(true, "Show WR Dashboard", group="Dashboard Settings")
dashPos = input.string("Top Right", "Dashboard Position", options=["Top Right", "Top Left", "Bottom Right", "Bottom Left"], group="Dashboard Settings")

// Visuals
showZigzag = input.bool(false, "Show Zig Zag", group="Visual Settings")
showPriceActionLabels = input.bool(false, "Show Price Action Labels", group="Visual Settings")
showBosLabels = input.bool(true, "Show BOS Labels", group="Visual Settings")
showEntryLabels = input.bool(true, "Show Entry Labels", group="Visual Settings")
showTrendEma = input.bool(false, "Show Trend EMA", group="Visual Settings")
showZoneDetails = input.bool(true, "Show Entry % Inside Zones", group="Visual Settings")
supplyColor = input.color(color.new(#ffcccc, 30), "Supply", group="Visual Settings", inline="supply")
supplyOutline = input.color(color.new(color.red, 75), "Outline", group="Visual Settings", inline="supply")
demandColor = input.color(color.new(#ccffcc, 30), "Demand", group="Visual Settings", inline="demand")
demandOutline = input.color(color.new(color.green, 75), "Outline", group="Visual Settings", inline="demand")

atr = ta.atr(50)
trendEma = ta.ema(close, trendEmaPeriod)
swingHigh = ta.pivothigh(high, swingLength, swingLength)
swingLow = ta.pivotlow(low, swingLength, swingLength)

var zoneBoxes = array.new_box()
var zonePoiLines = array.new_line()
var zoneTops = array.new_float()
var zoneBottoms = array.new_float()
var zonePois = array.new_float()
var zoneSl = array.new_float()
var zoneTp = array.new_float()
var zoneTypes = array.new_int()
var zoneActive = array.new_bool()
var zoneTraded = array.new_bool()

var tradeEntry = array.new_float()
var tradeSl = array.new_float()
var tradeTp = array.new_float()
var tradeType = array.new_int()
var tradeActive = array.new_bool()

var totalBuy = 0
var wonBuy = 0
var totalSell = 0
var wonSell = 0
var float lastHigh = na
var float lastLow = na

// Keep the number of drawn zones bounded while preserving the newest zones.
addZone(_type, _level, _pivotBar) =>
    zoneSize = atr * (boxWidth / 10.0)
    top = _type == 1 ? _level : _level + zoneSize
    bottom = _type == 1 ? _level - zoneSize : _level
    poi = bottom + (top - bottom) * (entryPct / 100.0)
    sl = _type == 1 ? top + syminfo.mintick * slBufferPoints : bottom - syminfo.mintick * slBufferPoints
    tp = _type == 1 ? poi - (sl - poi) * rrTarget : poi + (poi - sl) * rrTarget
    zoneName = _type == 1 ? "SELL POSITION" : "BUY POSITION"
    zoneText = showZoneDetails ? zoneName + "\nENTRY " + str.tostring(entryPct, "#.##") + "%\nPOI " + str.tostring(poi, format.mintick) + "\nSL " + str.tostring(slBufferPoints, "#.##") + "p | RR 1:" + str.tostring(rrTarget, "#.##") : zoneName
    zoneColor = _type == 1 ? supplyColor : demandColor
    outlineColor = _type == 1 ? supplyOutline : demandOutline
    textColor = _type == 1 ? color.rgb(127, 29, 29) : color.rgb(20, 83, 45)
    poiColor = _type == 1 ? color.rgb(220, 38, 38) : color.rgb(22, 163, 74)
    zoneBox = box.new(_pivotBar, top, bar_index, bottom, border_color=outlineColor, bgcolor=zoneColor, extend=extend.right, text=zoneText, text_halign=text.align_center, text_valign=text.align_center, text_color=textColor, text_size=size.small)
    poiLine = line.new(_pivotBar, poi, bar_index, poi, extend=extend.right, color=color.new(poiColor, 10), style=line.style_dashed, width=2)
    array.push(zoneBoxes, zoneBox)
    array.push(zonePoiLines, poiLine)
    array.push(zoneTops, top)
    array.push(zoneBottoms, bottom)
    array.push(zonePois, poi)
    array.push(zoneSl, sl)
    array.push(zoneTp, tp)
    array.push(zoneTypes, _type)
    array.push(zoneActive, true)
    array.push(zoneTraded, false)
    if array.size(zoneBoxes) > historyToKeep
        oldBox = array.shift(zoneBoxes)
        oldLine = array.shift(zonePoiLines)
        box.delete(oldBox)
        line.delete(oldLine)
        array.shift(zoneTops)
        array.shift(zoneBottoms)
        array.shift(zonePois)
        array.shift(zoneSl)
        array.shift(zoneTp)
        array.shift(zoneTypes)
        array.shift(zoneActive)
        array.shift(zoneTraded)

// Confirmed pivots create zones only after the pivot is known.
if not na(swingHigh)
    addZone(1, swingHigh, bar_index - swingLength)
    if showPriceActionLabels
        highText = na(lastHigh) ? "HH" : swingHigh >= lastHigh ? "HH" : "LH"
        label.new(bar_index - swingLength, swingHigh, highText, style=label.style_label_down, textcolor=color.black, color=color.new(color.white, 100), size=size.tiny)
    lastHigh := swingHigh
else if not na(swingLow)
    addZone(-1, swingLow, bar_index - swingLength)
    if showPriceActionLabels
        lowText = na(lastLow) ? "HL" : swingLow >= lastLow ? "HL" : "LL"
        label.new(bar_index - swingLength, swingLow, lowText, style=label.style_label_up, textcolor=color.black, color=color.new(color.white, 100), size=size.tiny)
    lastLow := swingLow

newBuyEntry = false
newSellEntry = false

// Resolve old simulated trades. If TP and SL occur in one candle, SL wins conservatively.
if array.size(tradeEntry) > 0
    for i = 0 to array.size(tradeEntry) - 1
        if array.get(tradeActive, i)
            tradeDirection = array.get(tradeType, i)
            tradeStop = array.get(tradeSl, i)
            tradeTarget = array.get(tradeTp, i)
            stopHit = tradeDirection == 1 ? low <= tradeStop : high >= tradeStop
            targetHit = tradeDirection == 1 ? high >= tradeTarget : low <= tradeTarget
            if stopHit or targetHit
                if tradeDirection == 1
                    if targetHit and not stopHit
                        wonBuy += 1
                else
                    if targetHit and not stopHit
                        wonSell += 1
                array.set(tradeActive, i, false)

openTrades = 0
if array.size(tradeActive) > 0
    for i = 0 to array.size(tradeActive) - 1
        if array.get(tradeActive, i)
            openTrades += 1

// Update zones, detect BOS, and create simulated trades on POI touches.
if array.size(zoneBoxes) > 0
    for i = 0 to array.size(zoneBoxes) - 1
        if array.get(zoneActive, i)
            zoneType = array.get(zoneTypes, i)
            top = array.get(zoneTops, i)
            bottom = array.get(zoneBottoms, i)
            poi = array.get(zonePois, i)
            zoneBox = array.get(zoneBoxes, i)
            bos = zoneType == 1 ? close >= top : close <= bottom
            if bos
                array.set(zoneActive, i, false)
                box.set_extend(zoneBox, extend.none)
                box.set_right(zoneBox, bar_index)
                box.set_text(zoneBox, "BOS")
                box.set_text_color(zoneBox, color.white)
                line.set_extend(array.get(zonePoiLines, i), extend.none)
                line.set_x2(array.get(zonePoiLines, i), bar_index)
                if showBosLabels
                    label.new(bar_index, zoneType == 1 ? top : bottom, "BOS", style=zoneType == 1 ? label.style_label_down : label.style_label_up, color=zoneType == 1 ? color.red : color.green, textcolor=color.white, size=size.tiny)
            else
                trendValid = zoneType == -1 ? (not useTrendFilter or close > trendEma) : (not useTrendFilter or close < trendEma)
                candleBody = math.abs(close - open)
                candleValid = zoneType == -1 ? close > open and close > poi : close < open and close < poi
                confirmationValid = not useCandleConfirmation or (candleValid and candleBody >= atr * minBodyAtr)
                capacityValid = not oneActiveTrade or openTrades == 0
                touchValid = high >= poi and low <= poi
                if tradeOnTouch and touchValid and trendValid and confirmationValid and capacityValid and (not oneTradePerZone or not array.get(zoneTraded, i))
                    array.push(tradeEntry, poi)
                    array.push(tradeSl, array.get(zoneSl, i))
                    array.push(tradeTp, array.get(zoneTp, i))
                    array.push(tradeType, zoneType == 1 ? -1 : 1)
                    array.push(tradeActive, true)
                    array.set(zoneTraded, i, true)
                    openTrades += 1
                    if zoneType == 1
                        totalSell += 1
                        newSellEntry := true
                        if showEntryLabels
                            label.new(bar_index, high, "SELL", style=label.style_label_down, color=color.new(color.red, 0), textcolor=color.white, size=size.tiny)
                    else
                        totalBuy += 1
                        newBuyEntry := true
                        if showEntryLabels
                            label.new(bar_index, low, "BUY", style=label.style_label_up, color=color.new(color.green, 0), textcolor=color.white, size=size.tiny)

plotshape(newBuyEntry, title="Simulated Buy Entry", style=shape.triangleup, location=location.belowbar, color=color.green, size=size.tiny, text="BUY")
plotshape(newSellEntry, title="Simulated Sell Entry", style=shape.triangledown, location=location.abovebar, color=color.red, size=size.tiny, text="SELL")
alertcondition(newBuyEntry, "SMC Buy Entry", "SMC demand POI touched: simulated BUY entry")
alertcondition(newSellEntry, "SMC Sell Entry", "SMC supply POI touched: simulated SELL entry")

// Draw levels for the latest active trade only.
var line activeSlLine = na
var line activeTpLine = na
var line activeEntryLine = na
var box activeRewardBox = na
var box activeRiskBox = na
var label activeEntryLabel = na
var label activeTargetLabel = na
var label activeStopLabel = na
if showTradeLevels and array.size(tradeEntry) > 0
    latest = array.size(tradeEntry) - 1
    if array.get(tradeActive, latest)
        activeEntry = array.get(tradeEntry, latest)
        activeStop = array.get(tradeSl, latest)
        activeTarget = array.get(tradeTp, latest)
        activeDirection = array.get(tradeType, latest)
        isBuy = activeDirection == 1
        if na(activeEntryLine)
            activeEntryLine := line.new(bar_index - 1, activeEntry, bar_index, activeEntry, extend=extend.right, color=color.white, width=2)
            activeSlLine := line.new(bar_index - 1, activeStop, bar_index, activeStop, extend=extend.right, color=color.red, style=line.style_dashed, width=1)
            activeTpLine := line.new(bar_index - 1, activeTarget, bar_index, activeTarget, extend=extend.right, color=color.lime, style=line.style_dashed, width=1)
            activeRewardBox := box.new(bar_index - 1, math.max(activeEntry, activeTarget), bar_index, math.min(activeEntry, activeTarget), bgcolor=color.new(color.green, 82), border_color=color.new(color.green, 35), extend=extend.right)
            activeRiskBox := box.new(bar_index - 1, math.max(activeEntry, activeStop), bar_index, math.min(activeEntry, activeStop), bgcolor=color.new(color.red, 82), border_color=color.new(color.red, 35), extend=extend.right)
            activeEntryLabel := label.new(bar_index, activeEntry, (isBuy ? "BUY POSITION" : "SELL POSITION") + "\nEntry: " + str.tostring(activeEntry, format.mintick) + "\nRisk/Reward: 1:" + str.tostring(rrTarget, "#.##"), style=label.style_label_left, color=color.rgb(31, 41, 55), textcolor=color.white, size=size.small)
            activeTargetLabel := label.new(bar_index, activeTarget, "TARGET\n" + str.tostring(activeTarget, format.mintick), style=label.style_label_left, color=color.rgb(5, 150, 105), textcolor=color.white, size=size.tiny)
            activeStopLabel := label.new(bar_index, activeStop, "STOP\n" + str.tostring(activeStop, format.mintick), style=label.style_label_left, color=color.rgb(239, 68, 68), textcolor=color.white, size=size.tiny)
        else
            line.set_y1(activeEntryLine, activeEntry)
            line.set_y2(activeEntryLine, activeEntry)
            line.set_y1(activeSlLine, activeStop)
            line.set_y2(activeSlLine, activeStop)
            line.set_y1(activeTpLine, activeTarget)
            line.set_y2(activeTpLine, activeTarget)
            box.set_top(activeRewardBox, math.max(activeEntry, activeTarget))
            box.set_bottom(activeRewardBox, math.min(activeEntry, activeTarget))
            box.set_top(activeRiskBox, math.max(activeEntry, activeStop))
            box.set_bottom(activeRiskBox, math.min(activeEntry, activeStop))
            label.set_y(activeEntryLabel, activeEntry)
            label.set_y(activeTargetLabel, activeTarget)
            label.set_y(activeStopLabel, activeStop)
    else
        if not na(activeEntryLine)
            line.delete(activeEntryLine)
            line.delete(activeSlLine)
            line.delete(activeTpLine)
            box.delete(activeRewardBox)
            box.delete(activeRiskBox)
            label.delete(activeEntryLabel)
            label.delete(activeTargetLabel)
            label.delete(activeStopLabel)
            activeEntryLine := na
            activeSlLine := na
            activeTpLine := na
            activeRewardBox := na
            activeRiskBox := na
            activeEntryLabel := na
            activeTargetLabel := na
            activeStopLabel := na

buyLoss = totalBuy - wonBuy
sellLoss = totalSell - wonSell
buyWr = totalBuy > 0 ? wonBuy * 100.0 / totalBuy : 0.0
sellWr = totalSell > 0 ? wonSell * 100.0 / totalSell : 0.0

panelPosition = dashPos == "Top Right" ? position.top_right : dashPos == "Top Left" ? position.top_left : dashPos == "Bottom Right" ? position.bottom_right : position.bottom_left
var table panel = table.new(panelPosition, 5, 4, border_width=1, border_color=color.gray, frame_color=color.gray, frame_width=1)
if barstate.islast and showDashboard
    headerColor = color.rgb(31, 41, 55)
    table.cell(panel, 0, 0, "SMC", bgcolor=headerColor, text_color=color.white, text_halign=text.align_center, text_size=size.tiny)
    table.cell(panel, 1, 0, "Trd", bgcolor=headerColor, text_color=color.white, text_halign=text.align_center, text_size=size.tiny)
    table.cell(panel, 2, 0, "W", bgcolor=headerColor, text_color=color.white, text_halign=text.align_center, text_size=size.tiny)
    table.cell(panel, 3, 0, "L", bgcolor=headerColor, text_color=color.white, text_halign=text.align_center, text_size=size.tiny)
    table.cell(panel, 4, 0, "WR", bgcolor=headerColor, text_color=color.white, text_halign=text.align_center, text_size=size.tiny)
    table.cell(panel, 0, 1, "Buy", bgcolor=color.new(color.green, 70), text_color=color.white, text_size=size.tiny)
    table.cell(panel, 1, 1, str.tostring(totalBuy), bgcolor=color.new(color.green, 70), text_color=color.white, text_size=size.tiny)
    table.cell(panel, 2, 1, str.tostring(wonBuy), bgcolor=color.new(color.green, 70), text_color=color.white, text_size=size.tiny)
    table.cell(panel, 3, 1, str.tostring(buyLoss), bgcolor=color.new(color.green, 70), text_color=color.white, text_size=size.tiny)
    table.cell(panel, 4, 1, str.tostring(buyWr, "#.##") + "%", bgcolor=color.new(color.green, 70), text_color=color.white, text_size=size.tiny)
    table.cell(panel, 0, 2, "Sell", bgcolor=color.new(color.red, 70), text_color=color.white, text_size=size.tiny)
    table.cell(panel, 1, 2, str.tostring(totalSell), bgcolor=color.new(color.red, 70), text_color=color.white, text_size=size.tiny)
    table.cell(panel, 2, 2, str.tostring(wonSell), bgcolor=color.new(color.red, 70), text_color=color.white, text_size=size.tiny)
    table.cell(panel, 3, 2, str.tostring(sellLoss), bgcolor=color.new(color.red, 70), text_color=color.white, text_size=size.tiny)
    table.cell(panel, 4, 2, str.tostring(sellWr, "#.##") + "%", bgcolor=color.new(color.red, 70), text_color=color.white, text_size=size.tiny)
    table.cell(panel, 0, 3, "Open", bgcolor=color.new(color.gray, 70), text_color=color.white, text_size=size.tiny)
    table.cell(panel, 1, 3, str.tostring(openTrades), bgcolor=color.new(color.gray, 70), text_color=color.white, text_size=size.tiny)
    table.cell(panel, 2, 3, "Zones", bgcolor=color.new(color.gray, 70), text_color=color.white, text_size=size.tiny)
    table.cell(panel, 3, 3, str.tostring(array.size(zoneBoxes)), bgcolor=color.new(color.gray, 70), text_color=color.white, text_size=size.tiny)
    table.cell(panel, 4, 3, "Touch", bgcolor=color.new(color.gray, 70), text_color=color.white, text_size=size.tiny)

plot(showTrendEma ? trendEma : na, "Trend EMA", color=color.orange, linewidth=2)

// Optional swing markers using confirmed pivots.
plot(showZigzag ? swingHigh : na, "Swing High", color=color.black, style=plot.style_cross, offset=-swingLength)
plot(showZigzag ? swingLow : na, "Swing Low", color=color.black, style=plot.style_cross, offset=-swingLength)
